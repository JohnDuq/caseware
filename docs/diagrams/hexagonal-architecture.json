  "cards": [
    {
      "dot": "cyan",
      "title": "Dependency Direction",
      "items": [
        "Inbound adapters know only input ports",
        "Application services depend only on output ports",
        "Spring and JPA remain outside the domain and application layers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Composition",
      "items": [
        "WorkerConfiguration connects ports to concrete implementations",
